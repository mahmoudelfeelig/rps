{
  "version": 1,
  "id": "rps",
  "source": {
    "repository": "mahmoudelfeelig/RPS",
    "default_branch": "main",
    "required_workflows": ["CI"]
  },
  "registry": {
    "host": "registry.elfeel.me",
    "image_namespace": "apps/rps",
    "release_repository": "releases/rps"
  },
  "release": {
    "strategy": "source-build",
    "components": [
      {
        "name": "web",
        "context": ".",
        "dockerfile": "frontend/Dockerfile",
        "build_args": {
          "VITE_API_URL": ""
        }
      },
      {
        "name": "api",
        "context": ".",
        "dockerfile": "backend/Dockerfile"
      }
    ]
  }
}
